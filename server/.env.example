# Port d'ecoute du serveur HTTP
PORT=3000

# Secret utilise pour signer les JSON Web Tokens (a remplacer par une valeur aleatoire longue en production)
# Exemple de generation : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret_before_deploying

# Duree de validite des tokens (format accepte par la lib jsonwebtoken)
JWT_EXPIRES_IN=7d

# Emplacement du fichier de base de donnees SQLite (cree automatiquement s'il n'existe pas)
DB_PATH=./data/app.db
