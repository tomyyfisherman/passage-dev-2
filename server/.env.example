# Port d'écoute du serveur HTTP
PORT=3000

# Secret utilisé pour signer les JSON Web Tokens (à remplacer par une valeur aléatoire longue en production)
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret_before_deploying

# Durée de validité des tokens (format accepté par la lib jsonwebtoken)
JWT_EXPIRES_IN=7d

# Emplacement du fichier de base de données SQLite, utilisé uniquement si DATABASE_URL n'est pas défini
DB_PATH=./data/app.db

# Optionnel : chaîne de connexion PostgreSQL (ex. base gratuite Neon.tech).
# Si définie, le serveur utilise PostgreSQL au lieu de SQLite (voir le README,
# section "Persistance en production"). Laisser vide en local pour utiliser SQLite.
# DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/dbname?sslmode=require
